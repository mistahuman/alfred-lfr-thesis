* COMPO FEEDING                                                       

COMPO := COMPO: COMPO EDIOBJ MICROLIB ::
EDIT 5
STEP UP <<Compo>>
'DCA' <<N_Pb_void>>
'LEGO' 'VSXP'
;
EDIOBJ MICROLIB MICROLIB2 := DELETE: EDIOBJ MICROLIB MICROLIB2 ;

