EDIT 5
STEP UP <<Compo>>
'DCA' <<N_Pb_void>>
'LEGO' 'REPN'
;
EDIOBJ MICROLIB MICROLIB2 := DELETE: EDIOBJ MICROLIB MICROLIB2 ;

