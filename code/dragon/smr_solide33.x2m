 Ni62_EM10 = 'Ni62' <<N_Ni62_Eco>>
 Ni64_EM10 = 'Ni64' <<N_Ni64_Eco>>
 Mn55_EM10 = 'Mn55' <<N_Mn55_Eco>>
 Mo92_EM10 = 'Mo92' <<N_Mo92_Eco>>
