EVALUATE N_Ni62_Esvco := N_Ni62_E p_Esv * ;
EVALUATE N_Ni64_Esvco := N_Ni64_E p_Esv * ;
EVALUATE N_Mn55_Esvco := N_Mn55_E p_Esv * ;
EVALUATE N_Mo92_Esvco := N_Mo92_E p_Esv * ;
EVALUATE N_Mo94_Esvco := N_Mo94_E p_Esv * ;
EVALUATE N_Mo95_Esvco := N_Mo95_E p_Esv * ;
EVALUATE N_Mo96_Esvco := N_Mo96_E p_Esv * ;
EVALUATE N_Mo97_Esvco := N_Mo97_E p_Esv * ;
EVALUATE N_Mo98_Esvco := N_Mo98_E p_Esv * ;
EVALUATE N_Mo100Esvco := N_Mo100_E p_Esv * ;
EVALUATE N_C_Esvco := N_C_E p_Esv * ;
EVALUATE N_Si_Esvco := N_Si_E p_Esv * ;
EVALUATE N_Ti_Esvco := N_Ti_E p_Esv * ;

*-----------------------------------------------------------------------
* AFFICHAGE DES RESULTATS                                              *
*-----------------------------------------------------------------------

:: <<N_Pb_co>> <<N_B10_co_1>> <<N_B10_co_2>> <<N_B11_co_1>>
<<N_B11_co_2>> <<N_Fe54_Eco>> <<N_Fe56_Eco>> <<N_Fe57_Eco>>
