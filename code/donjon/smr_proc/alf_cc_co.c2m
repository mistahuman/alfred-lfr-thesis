* N_Cr50_Eco N_Cr52_Eco N_Cr53_Eco N_Cr54_Eco N_Ni58_Eco 
* N_Ni60_Eco N_Ni61_Eco N_Ni62_Eco N_Ni64_Eco N_Mn55_Eco
* N_Mo92_Eco N_Mo94_Eco N_Mo95_Eco N_Mo96_Eco N_Mo97_Eco N_Mo98_Eco
* N_Mo100_Eco N_C_Eco N_Si_Eco N_Ti_Eco
* N_Fe54_APbco N_Fe56_APbco N_Fe57_APbco N_Fe58_APbco N_Cr50_APbco 
* N_Cr52_APbco N_Cr53_APbco N_Cr54_APbco N_Ni58_APbco N_Ni60_APbco 
