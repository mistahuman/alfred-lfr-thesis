*******************************************************************
*                                                                 *
* Procedure :  SetFuelMap.c2m                                    *
* Purpose   :  Coarse fuelmap definition for ALFRED hex core      *
* Author    :  Marco Lanconelli (2018-2019)                       *
*                                                                 *
* CALL      :  Fmap Matex := SetFuelMap Matex ;                  *
*                                                                 *
*******************************************************************
PARAMETER   Fmap Matex :: ::: LINKED_LIST Fmap Matex ; ;
MODULE      RESINI: END: ;

*******************************************************************
*------------
*  Mix number assignments in Saphybs
* 0  : solide
* 1  : combustible fissile coeur interne
* 2  : combustible fissile coeur externe
* 3  : combustible fertile
*------------

Fmap Matex := RESINI: Matex ::
    EDIT 1
    ::: GEO: HEXZ 271 16
      Z- VOID Z+ VOID
      HBC COMPLETE VOID
      SIDE 9.872689603
      MIX
      
* etages 1 a 3 : reflecteurs
* etages 4 a 5 : fertile couverture
* etages 6 et 7 : fissile
* etage  8 : fertile int, fissile ext
* etages 9 et 10 : fissile
* etages 11 a 12 : fissile ext
* etages 13 a 16 : reflecteurs

