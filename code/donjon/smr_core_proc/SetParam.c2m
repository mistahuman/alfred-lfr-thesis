*******************************************************************
*                                                                 *
* Procedure :  SetParam.c2m                                       *
* Purpose   :  Coarse fuelmap definition for ALFRED hex core      *
* Author    :  Marco Lanconelli (2018-2019)                       *
*                                                                 *
* CALL      :  Fmap := SetParam Fmap :: (data) ;                *
*                                                                 *
*******************************************************************
PARAMETER   Fmap :: ::: LINKED_LIST Fmap ; ;
MODULE      RESINI: END: ;

REAL i1 i2 i3 i4 e1 e2 e3 e4 b1 b2 b3 b4 ;

REAL T_comb T_Pb N_Pb ;
:: >>T_comb<< >>T_Pb<< >>N_Pb<< ;

************************************************************************
* MASSIC POWER OF A FBR                                                *
************************************************************************
REAL X := 1.0 ;
REAL day := 0.0 ;

REAL Fuelpwri ;
REAL Fuelpwre ;
REAL Fuelpwrb ;

REAL Fuelpwri1 := 40.0 ; ! W/g ou kW/kg ou MW/t internal core
REAL Fuelpwre1 := 40.0 ; ! W/g ou kW/kg ou MW/t external core
REAL Fuelpwrb1 := 40.0 ; ! W/g ou kW/kg ou MW/t fertile blanket

EVALUATE Fuelpwri := Fuelpwri1 X * ;
EVALUATE Fuelpwre := Fuelpwre1 X * ;
EVALUATE Fuelpwrb := Fuelpwrb1 X * ;

********old burnup****************

EVALUATE i1 := 0.0 ;
EVALUATE i2 := Fuelpwri day * ;
EVALUATE i3 := Fuelpwri day * i2 + ;
EVALUATE i4 := Fuelpwri day * i3 + ;
                      
EVALUATE e1 := 0.0 ;  
EVALUATE e2 := Fuelpwre day * ;
EVALUATE e3 := Fuelpwre day * e2 + ;
EVALUATE e4 := Fuelpwre day * e3 + ;
                        
EVALUATE b1 := 0.0 ;    
EVALUATE b2 := Fuelpwrb day * ;
EVALUATE b3 := Fuelpwrb day * b2 + ;
EVALUATE b4 := Fuelpwrb day * b3 + ;


******homogeneuos burnup***********

EVALUATE b1 := 0.0 ;
EVALUATE b2 := b1 ;
EVALUATE b3 := b1 ;
EVALUATE b4 := b1 ;
     

Fmap := RESINI: Fmap :: EDIT 2

    BTYPE INST-BURN
    INST-BVAL BUND

