****************************************************************
*                                                              *
* Procedure :  PowComponent.c2m                                *
* Purpose   :  Reactor Physics component                       *
* Author    :  A. Hebert                                       *
*                                                              *
* CALL      :                                                  *
*  Fmap Matex Flux := PowComponent Fmap Matex Flux Cpo Track   *
*    :: <<iter>> <<powi>> <<densB>> ;                          *
*                                                              *
****************************************************************
PARAMETER  Fmap Matex Flux Cpo1 Cpo2 Cpo3 Cpo4 Track Power ::
  ::: LINKED_LIST Fmap Matex Flux Cpo1 Cpo2 Cpo3 Cpo4 
  Track Power ; ;
  
MODULE UTL: NCR: MACINI: TRIVAA: FLUD: FLPOW: GREP: DELETE: END: ;

LINKED_LIST MacroF System Macro1 Macro2 ;

PROCEDURE alf_N_Pb ;
 
INTEGER iter ;
 :: >>iter<< ;
REAL powi densB ;
 :: >>powi<< >>densB<< ;

STRING  Dir1 := "FISSILE" ;
STRING  Dir2 := "FERTILE" ;
STRING  Dir3 := "FISSILE_EX" ;
STRING  Dir4 := "SOLIDE" ;

REAL keffn mbp mcp ;

*------
*parameter for rods 0=TBE,1=TBI,2=THALF
*------
INTEGER rod := 0 ; 


*--
* Reference parameter values
*--

REAL 
T_comb_0 T_clad_0 T_Pb_0
:= 750.0 480.0 440.0
;

REAL N_Pb_0 N_Pb ;

alf_N_Pb :: <<T_Pb_0>>
  >>N_Pb_0<<
  ;
  
* Conversion des temperatures en Kelvin

REAL T_comb_K T_clad_K T_Pb_K ;
EVALUATE T_comb_K := T_comb_0 273.16 + ;
EVALUATE T_clad_K := T_clad_0 273.16 + ;
EVALUATE T_Pb_K := T_Pb_0 273.16 + ;

REAL burnup := 0.0 ;

*------
* Cross-section database interpolation
*
* remark: all SET with (*) because alrealdy defined in Fmap
* ---> i think it's useless re-SET
*
*------
MacroF := NCR: Cpo1 Cpo2 Cpo3 Fmap ::
           EDIT 2
           MACRO LINEAR
           TABLE Cpo1 <<Dir1>> 'BURN'
             MIX 1 FROM 1
             INST-BURN
                  * SET LINEAR 'BURN' MAP
                  * SET LINEAR 'BURN' <<burnup>>
                  * SET CUBIC 'TF'  <<temp_comb_0>>
                  * SET CUBIC 'TCA' <<temp_mode_0>>
                  * SET CUBIC 'DCA' <<dens_mode_0>>
            ENDMIX 
            TABLE Cpo2 <<Dir1>> 'BURN'
               MIX 2 FROM 1
                 INST-BURN
                   * SET LINEAR 'BURN' MAP
                   * SET LINEAR 'BURN' <<burnup>>
                   * SET CUBIC 'TF' MAP !<<temp_comb_0>>
                   * SET CUBIC 'TCA' <<temp_mode_0>>
                   * SET CUBIC 'DCA' <<dens_mode_0>>
             ENDMIX 
            TABLE Cpo3 <<Dir3>> 'BURN'
                MIX 3 FROM 1
                INST-BURN
                   * SET LINEAR 'BURN' MAP
                   * SET LINEAR 'BURN' <<burnup>>
                   * SET CUBIC 'TF' <<temp_comb_0>>
                   * SET CUBIC 'TCA' <<temp_mode_0>>
                   * SET CUBIC 'DCA' <<dens_mode_0>>
             ENDMIX 
; 

*---
* Reflector macrolib COMPO
*---

IF rod 0 = THEN
ECHO "--------------------tbe rods" ;
Macro1 := NCR: Cpo4 ::
    EDIT 1
    MACRO 
    NMIX 16 COMPO Cpo4 <<Dir4>>
    MIX  4 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  5 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  6 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  7 FROM 1 SET 'LEGO' ARSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  8 FROM 1 SET 'LEGO' ARSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  9 FROM 1 SET 'LEGO' REPN SET DCA <<N_Pb_0>> ENDMIX
    MIX 10 FROM 1 SET 'LEGO' REFS SET DCA <<N_Pb_0>> ENDMIX
    MIX 11 FROM 1 SET 'LEGO' PRNL SET DCA <<N_Pb_0>> ENDMIX
    MIX 12 FROM 1 SET 'LEGO' PRNS SET DCA <<N_Pb_0>> ENDMIX
    MIX 13 FROM 1 SET 'LEGO' PLPb SET DCA <<N_Pb_0>> ENDMIX
    MIX 14 FROM 1 SET 'LEGO' BCHN SET DCA <<N_Pb_0>> ENDMIX
    MIX 15 FROM 1 SET 'LEGO' VSXP SET DCA <<N_Pb_0>> ENDMIX
    MIX 16 FROM 1 SET 'LEGO' CALE SET DCA <<N_Pb_0>> ENDMIX
; 
ELSEIF rod 1 = THEN
ECHO "--------------------tbi rods" ;
Macro1 := NCR: Cpo4 ::
    EDIT 1
    MACRO 
    NMIX 16 COMPO Cpo4 <<Dir4>>
    MIX  4 FROM 1 SET 'LEGO' COSU SET DCA <<N_Pb_0>> ENDMIX
    MIX  5 FROM 1 SET 'LEGO' COIN SET DCA <<N_Pb_0>> ENDMIX
    MIX  6 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  7 FROM 1 SET 'LEGO' ARRE SET DCA <<N_Pb_0>> ENDMIX
    MIX  8 FROM 1 SET 'LEGO' ARSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  9 FROM 1 SET 'LEGO' REPN SET DCA <<N_Pb_0>> ENDMIX
    MIX 10 FROM 1 SET 'LEGO' REFS SET DCA <<N_Pb_0>> ENDMIX
    MIX 11 FROM 1 SET 'LEGO' PRNL SET DCA <<N_Pb_0>> ENDMIX
    MIX 12 FROM 1 SET 'LEGO' PRNS SET DCA <<N_Pb_0>> ENDMIX
    MIX 13 FROM 1 SET 'LEGO' PLPb SET DCA <<N_Pb_0>> ENDMIX
    MIX 14 FROM 1 SET 'LEGO' BCHN SET DCA <<N_Pb_0>> ENDMIX
    MIX 15 FROM 1 SET 'LEGO' VSXP SET DCA <<N_Pb_0>> ENDMIX
    MIX 16 FROM 1 SET 'LEGO' CALE SET DCA <<N_Pb_0>> ENDMIX
; 
ELSEIF rod 2 = THEN
ECHO "--------------------thalf rods" ;
ECHO "--------error on code---------" ;
Macro1 := NCR: Cpo4 ::
    EDIT 1
    NMIX 16 COMPO Cpo4 <<Dir4>>
    MIX  4 FROM 1 SET 'LEGO' COIN SET DCA <<N_Pb_0>> ENDMIX
    MIX  5 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  6 FROM 1 SET 'LEGO' COSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  7 FROM 1 SET 'LEGO' ARSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  8 FROM 1 SET 'LEGO' ARSV SET DCA <<N_Pb_0>> ENDMIX
    MIX  9 FROM 1 SET 'LEGO' REPN SET DCA <<N_Pb_0>> ENDMIX
    MIX 10 FROM 1 SET 'LEGO' REFS SET DCA <<N_Pb_0>> ENDMIX
    MIX 11 FROM 1 SET 'LEGO' PRNL SET DCA <<N_Pb_0>> ENDMIX
    MIX 12 FROM 1 SET 'LEGO' PRNS SET DCA <<N_Pb_0>> ENDMIX
    MIX 13 FROM 1 SET 'LEGO' PLPb SET DCA <<N_Pb_0>> ENDMIX
    MIX 14 FROM 1 SET 'LEGO' BCHN SET DCA <<N_Pb_0>> ENDMIX
    MIX 15 FROM 1 SET 'LEGO' VSXP SET DCA <<N_Pb_0>> ENDMIX
    MIX 16 FROM 1 SET 'LEGO' CALE SET DCA <<N_Pb_0>> ENDMIX
; 
ENDIF ;

  
Macro2 Matex := MACINI: Matex Macro1 MacroF :: EDIT 0 ;
*--
* Steady-state diffusion calculation
*--
System := TRIVAA: Macro2 Track :: EDIT 0 ;

IF iter 1 = THEN
  Flux := FLUD: System Track ::
    EDIT 10 ADI 4 ACCE 5 3 ;
ELSE
  Flux := FLUD: Flux System Track ::
    EDIT 10 ;
ENDIF ;
System MacroF Macro1 Macro2 := DELETE: System MacroF Macro1 Macro2 ;
*--
* Thermo-hydraulics calculation
*--

Power Fmap := FLPOW: Fmap Flux Track Matex
                :: EDIT 13 PTOT <<powi>>
                *PRINT MAP
                PRINT DISTR FLUX 
                ;
***remark (PRINT DISTR FLUX) print flux over whole reactor              
                
**************print directories****************************                  
*                
*                
*Fmap := UTL: Fmap ::
*    EDIT 5
*    DIR
*;
*Power := UTL: Power ::
*    EDIT 5
*    DIR
*    IMPR FLUX *
*;
*Flux := UTL: Flux ::
*    EDIT 5
*    DIR
*;
*
***********
***** print result ****************************************
************

ECHO "-------------- RESULTs --------------" ;

GREP: Flux   ::
  GETVAL 'K-EFFECTIVE ' 1  >>keffn<<   ;
ECHO "K-effective = " keffn  ;
GREP: Power :: GETVAL 'PMAX-BUND' 1 >>mbp<< ;
GREP: Power :: GETVAL 'PMAX-CHAN' 1 >>mcp<< ;
ECHO "PMAX-BUND=" mbp "PMAX-CHAN=" mcp ;


END: ;
