 		\begin{tikzpicture}
 			\useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
			\fill[color=MedianOrange] (0,6) rectangle (1.5, 7);
			\fill[color=MedianLightBlue] (1.6, 6) rectangle (\the\paperwidth, 7);
 		\end{tikzpicture}
		
	}
	\frame{\sectionpage}
}}
