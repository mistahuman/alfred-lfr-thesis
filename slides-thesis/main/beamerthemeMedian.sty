\newcommand{\finalframe}[2]{
	 \bgroup\setbeamertemplate{background}{	 
	 \begin{tikzpicture}
		\useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
		\fill[color=MedianOrange] (0,0)  rectangle(\the\paperwidth,1.2);
		\fill[color=MedianOrange] (0,8.4) rectangle(\the\paperwidth,\the\paperheight);

		\begin{pgfonlayer}{background}
			\clip (0,1.2) rectangle ++(\the\paperwidth,7.9);
			\fill[color=sfondo_copertina] (0,1.2) rectangle (\the\paperwidth,\the\paperheight);
			\node[align=center] at ({0.5*\the\paperwidth},{0.5*\the\paperheight})               
			      {\includegraphics[width=1.5\textwidth]{#2}};				%%% BACKGROUND IMAGE FOR FINAL FRAME
		\end{pgfonlayer}
		\node[annotation, color = MedianOrange, draw,thick, text width=10cm, 
		     fill=sfondo_copertina!30,opacity=.70,text opacity=1,inner sep=1cm,
		     align = center,font =  \fontsize{1.3cm}{1.3cm}\selectfont] 
		     at ({0.5*\the\paperwidth},{0.5*\the\paperheight}) {#1};
	 \end{tikzpicture}}
	 \begin{frame}[plain]
	 \end{frame}\egroup
}	 
